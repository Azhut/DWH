# Скопируйте в .env и настройте под среду

APP_ENV=development
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=sport_data
API_HOST=0.0.0.0
API_PORT=2700
DEBUG=True
ENABLE_PROFILING=false

# FlatData: duckdb (по умолчанию) | mongo (legacy)
FLATDATA_STORAGE=duckdb
DUCKDB_PATH=./data/flat_data.duckdb
DUCKDB_MIGRATION_BATCH_SIZE=50000

MONGO_USE_TRANSACTIONS=true
MONGO_TRANSACTION_MAX_FLAT_RECORDS=30000
FLATDATA_BULK_CHUNK_SIZE=3000
